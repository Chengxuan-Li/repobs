# repobs reads these optional variables. Copy to .env.local only for local experiments;
# never commit real values. None of these are secrets.

# Loopback port (the server tries this port and the next 9 if it is occupied).
# REPOBS_PORT=47321

# App data directory (database, install secret, logs). Default: %LOCALAPPDATA%\repobs
# REPOBS_DATA_DIR=C:\Users\me\AppData\Local\repobs

# Provider homes (also configurable in Settings). Defaults follow the providers' own variables.
# CLAUDE_CONFIG_DIR=C:\Users\me\.claude
# CODEX_HOME=C:\Users\me\.codex
